# ============================================================================
# NEURONIX ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# Which LLM provider to use: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key
# Get it: https://ai.google.dev/
# Steps: 1. Visit link, 2. Click "Get API key", 3. Create New API Key, 4. Copy here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT API Key  
# Get it: https://platform.openai.com/api-keys
# Steps: 1. Visit link, 2. Login, 3. Create new API key, 4. Copy here
OPENAI_API_KEY=your_openai_api_key_here

# Model to use
# For Gemini: "gemini-pro" or "gemini-pro-vision"
# For OpenAI: "gpt-3.5-turbo" or "gpt-4"
LLM_MODEL=gemini-pro

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database type: "sqlite", "postgresql", "mysql"
DB_TYPE=sqlite

# For SQLite (development):
# DB_PATH=neuronix.db

# For PostgreSQL (production):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=neuronix
# DB_USER=postgres
# DB_PASSWORD=your_password

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application environment: "development" or "production"
APP_ENV=development

# Debug mode: true or false
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# RAG SYSTEM CONFIGURATION
# ============================================================================

# ChromaDB settings
CHROMADB_PATH=./chroma_data
CHROMADB_COLLECTION=neuronix_clinical

# Embeddings model
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# SECURITY
# ============================================================================

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000

# Session timeout (minutes)
SESSION_TIMEOUT=30
